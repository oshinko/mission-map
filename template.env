# API や Web アプリのエンドポイント URL
# ローカル開発では http://localhost:8000 を利用
# デプロイ時には実際の公開 URL に変更してください
ENDPOINT=http://localhost:8000

# ホストマシン側のポート番号
HOST_PORT=8000

# PostgreSQL の接続設定
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# アプリケーションの情報（UI 表示などに使用）
# カスタムしたい場合のみコメントを外して編集してください
# TITLE=My Favorite Map  # ページタイトルに使われます
# DESCRIPTION=  # 説明文（検索結果などに表示される概要）をここに記載できます
